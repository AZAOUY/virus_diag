@@ -0,0 +1,35 @@
+import numpy as np
+import pytest
+from core.naive_bayes import GaussianNaiveBayes
+from pipeline.predictor import ClinicalPredictor
+
+
+def _data():
+    rng = np.random.default_rng(0)
+    X = rng.normal(size=(200, 2))
+    y = (X[:, 0] > 0).astype(float)
+    return X, y
+
+
+def test_naive_bayes_apprend():
+    X, y = _data()
+    model = GaussianNaiveBayes().train(X, y)
+    assert ((model.predict(X) >= 0.5) == y).mean() > 0.9
+
+
+def test_probabilites_entre_0_et_1():
+    X, y = _data()
+    proba = GaussianNaiveBayes().train(X, y).predict(X)
+    assert np.all((proba >= 0) & (proba <= 1))
+
+
+def test_predict_sans_entrainement():
+    with pytest.raises(RuntimeError):
+        GaussianNaiveBayes().predict([[1, 2]])
+
+
+def test_compatible_clinical_predictor():
+    X, y = _data()
+    model = GaussianNaiveBayes().train(X, y)
+    assert ClinicalPredictor(model).diagnose([[3.0, 0.0]]) == "Infecté"
+    assert ClinicalPredictor(model).diagnose([[-3.0, 0.0]]) == "Sain"
